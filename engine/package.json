{
  "name": "@batsols/engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BatWos background engine: WhatsApp sessions, campaign scheduler, Google Maps scraper",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "browsers": "playwright install chromium"
  },
  "dependencies": {
    "@hapi/boom": "^9.1.4",
    "@batsols/shared": "*",
    "@supabase/supabase-js": "^2.117.2",
    "baileys": "7.0.0-rc14",
    "dotenv": "^18.0.5",
    "pino": "^10.4.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
