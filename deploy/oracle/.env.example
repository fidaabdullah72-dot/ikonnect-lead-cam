# Copy to deploy/oracle/.env and fill in. Never commit the real .env.

# Address of the app. No domain? Use your server's IP with sslip.io, e.g. 141-147-12-34.sslip.io
DOMAIN=141-147-12-34.sslip.io

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Secret / service-role key: bypasses row-level security, server only
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Optional: default Google Places API key (workspaces can also set their own in Settings → Integrations)
GOOGLE_PLACES_API_KEY=

# Set to true once your team has joined; invite links keep working
DISABLE_SIGNUP=false
